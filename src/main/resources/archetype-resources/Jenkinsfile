// Built by the kvm-server Jenkins (Kubernetes agent pods, one build at a time).
// 'mvn verify' runs the tests, JaCoCo coverage and the Spotless format check;
// run 'mvn spotless:apply' locally when the format check fails.
pipeline {
  agent {
    kubernetes {
      defaultContainer 'maven'
      yaml '''
        spec:
          containers:
            - name: maven
              image: maven:3.9.16-eclipse-temurin-25
              command: ["cat"]
              tty: true
              resources:
                requests: { memory: 768Mi, cpu: 250m }
                limits: { memory: 1Gi }
            - name: jnlp
              resources:
                requests: { memory: 256Mi, cpu: 100m }
                limits: { memory: 512Mi }
      '''
    }
  }
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 30, unit: 'MINUTES')
  }
  stages {
    // SonarQube analyses master and pull requests. A PR is its own analysis (community branch plugin,
    // kvm-server ADR-0059), so it never overwrites master's result; plain branch builds are not analysed.
    stage('Build, test, analyse') {
      steps {
        script {
          if (env.BRANCH_NAME == 'master' || env.CHANGE_ID) {
            withSonarQubeEnv('SonarQube') {
              // the checkout belongs to the jnlp user; let git (Sonar blame) read it as root
              sh 'git config --global --add safe.directory "$WORKSPACE"'
              sh 'mvn -B -ntp verify sonar:sonar' + sonarPullRequestArgs()
            }
          } else {
            sh 'mvn -B -ntp verify'
          }
        }
      }
    }
    stage('Quality gate') {
      when { anyOf { branch 'master'; changeRequest() } }
      steps {
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true   // SonarQube calls back via its webhook
        }
      }
    }
  }
}

// PR analysis parameters; single quotes: the shell expands the variables, not Groovy
def sonarPullRequestArgs() {
  if (!env.CHANGE_ID) {
    return ''
  }
  return ' -Dsonar.pullrequest.key="$CHANGE_ID" -Dsonar.pullrequest.branch="$CHANGE_BRANCH" -Dsonar.pullrequest.base="$CHANGE_TARGET"'
}
